# MongoDB Atlas connection string. Every database on the cluster is shown as an inventory
# (except admin, local, config and stiksel_inventaris, where the app keeps its history).
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Login: when both are set, everyone logs in with this one password (session cookie for 30 days).
# Changing AUTH_SECRET logs everyone out. Generate one with: openssl rand -base64 32
APP_PASSWORD=
AUTH_SECRET=

# Optional extra password for the CSV import
IMPORT_PASSWORD=

# Stock assistant (Ask the AI from the search field); leave empty to hide it
GEMINI_API_KEY=

# Access control (see proxy.js)
# Comma separated list of allowed IPs
ALLOWED_IPS=
# Shared secret that Cloudflare adds as the "x-origin-secret" header (Transform Rule).
# When set, requests without it are refused and CF-Connecting-IP becomes trustworthy.
CF_ORIGIN_SECRET=
