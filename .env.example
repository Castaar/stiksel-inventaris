# MongoDB Configuration
# Get this from your MongoDB Atlas dashboard
# Example: mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# Next.js Configuration
# Set this to your domain (e.g., localhost:3000 for dev, yourdomain.com for production)
NEXT_PUBLIC_API=localhost:3000

# Node Environment
NODE_ENV=development

# SendGrid Configuration (for email functionality)
# Get this from your SendGrid dashboard if you plan to use email features
SG_API_KEY=your_sendgrid_api_key_here

# IP Whitelist
# Managed in middleware.js - add additional whitelisted IPs there
